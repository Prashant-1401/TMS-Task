# ─────────────────────────────────────────────────────────────
# TMS Frontend — environment template
# Copy to .env and fill in. No secrets belong here: this file is
# bundled into the public JS build.
# ─────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=https://your-backend.onrender.com

# Optional — Sentry error tracking for the frontend
VITE_SENTRY_DSN=

# NOTE: VITE_API_KEY has been REMOVED. It was a shared secret exposed in the
# public bundle. The API now accepts JWT Bearer tokens only.
