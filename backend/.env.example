# ─────────────────────────────────────────────────────────────
# TMS Backend — production configuration template
# Copy to backend/.env and fill in real values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# REQUIRED — Postgres is the only primary database (async driver)
# Render Postgres gives: postgresql://... — the app converts to asyncpg automatically.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# REQUIRED — JWT signing key. Generate: openssl rand -hex 32
# The backend REFUSES to start with a missing/weak/default value.
SECRET_KEY=

# REQUIRED in production — comma-separated allowed CORS origins
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Rate limiting (per-minute)
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_AI_PER_MIN=20

# Environment (production disables /docs)
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Object storage (Cloudflare R2 recommended — S3-compatible) ──
S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=tms-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_EXPIRY_SECONDS=900
# Leave empty to use presigned URLs; set to a public CDN base if you prefer
S3_PUBLIC_BASE_URL=
# For local dev without S3, attachments fall back to local disk (S3_LOCAL_DIR)

# ── AI (optional) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Email (optional) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=admin@example.com
TEAM_EMAIL=team@example.com
FRONTEND_URL=https://your-frontend.vercel.app

# ── Master break-glass account (optional, prefer leaving empty) ──
MASTER_USER=
MASTER_PASSWORD=

# ── Google Sheets — OPTIONAL export/mirror ONLY (never a primary DB) ──
GOOGLE_SHEETS_CREDENTIALS_PATH=backend/secrets/tms-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=Actions

# ── Observability (optional) ──
SENTRY_DSN=

# NOTE: USE_GOOGLE_SHEETS_AS_DB and the shared API_KEY auth have been REMOVED.
# Authentication is JWT-only.
